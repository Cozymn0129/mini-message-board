<h1><%= title %></h1>
<form method="POST" action="/messages/<%= id %>/edit">
    <div>
        <label for="messageUser">Name:</label>
        <input type="text" id="messageUser" name="messageUser" value="<%= message.user %>">
    </div>
    <div>
        <label for="messageText">Message:</label>
        <textarea name="messageText" id="messageText" rows="4" cols="50" required><%= message.text %></textarea>
    </div>
    <button type="submit">Update</button>
</form>

<p><a href="/">Back to Top</a></p>
